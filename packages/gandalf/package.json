{
  "name": "@unergy/gandalf",
  "version": "0.1.0",
  "description": "Unergy's design system: Vue 3 components on shadcn-vue and Reka UI, styled with Tailwind CSS v4.",
  "keywords": [
    "vue",
    "nuxt",
    "tailwindcss",
    "shadcn",
    "design-system",
    "components"
  ],
  "homepage": "https://github.com/unergy/gandalf#readme",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unergy/gandalf.git",
    "directory": "packages/gandalf"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui/*": {
      "types": "./dist/components/ui/*/index.d.ts",
      "import": "./dist/components/ui/*/index.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt/module.d.ts",
      "import": "./dist/nuxt/module.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./tokens.css": "./dist/styles/tokens.css"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "lint:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints styles.css tokens.css --ignore-rules internal-resolution-error"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.0",
    "@nuxt/kit": "^4.4.2",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.9.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vue-sonner": "^2.0.9"
  },
  "peerDependencies": {
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "nuxt": "^4.0.0",
    "tailwindcss": "^4.2.2",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.31",
    "vue-input-otp": "^0.3.2"
  },
  "peerDependenciesMeta": {
    "@unovis/ts": {
      "optional": true
    },
    "@unovis/vue": {
      "optional": true
    },
    "embla-carousel": {
      "optional": true
    },
    "embla-carousel-vue": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "vaul-vue": {
      "optional": true
    },
    "vee-validate": {
      "optional": true
    },
    "vue-input-otp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nuxt/schema": "^4.4.2",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "embla-carousel": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "nuxt": "^4.4.2",
    "publint": "^0.3.25",
    "tailwindcss": "^4.2.2",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.31",
    "vue-input-otp": "^0.3.2",
    "vue-tsc": "^3.3.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
